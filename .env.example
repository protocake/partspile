# Copy values into your environment (do not commit a real .env)
# Friendlier path for provider=anthropic: run `partspile` and paste your key at
# /setup — it lands in ~/.partspile/config (owner-readable), env vars still win.
PARTS_PILE_PROVIDER=claude_code # claude_code (headless Claude Code, subscription auth) | anthropic (API key) | ollama | openai_compat (local model)
PARTS_PILE_MODEL=claude-opus-5  # model id for claude_code/anthropic, or the local model name for ollama/openai_compat
ANTHROPIC_API_KEY=              # provider=anthropic only; env or ~/.partspile/config, never in repo
PARTS_PILE_BASE_URL=            # openai_compat only, e.g. http://localhost:1234/v1 (LM Studio)
PARTS_PILE_DATA_DIR=            # app state root; default ~/.partspile (db, photos, cutouts, config)
PARTS_PILE_DB_PATH=             # override just the sqlite path (default <data dir>/partspile.sqlite3)
PARTS_PILE_FIXTURES_DIR=        # eval only: path to a partspile-fixtures clone's fixtures/ dir
